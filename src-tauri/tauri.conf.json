{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toutiao Sync Desktop",
  "version": "0.1.0",
  "identifier": "com.alex.toutiao-sync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:runtime && npm run build",
    "devUrl": "http://127.0.0.1:14321",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "\u4eca\u65e5\u5934\u6761\u6536\u85cf/\u559c\u6b22\u540c\u6b65",
        "width": 1440,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": ["embedded-sync-runtime/scripts", "embedded-sync-runtime/build-info.json"]
  }
}
